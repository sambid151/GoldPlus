# ---- Rate source -------------------------------------------------------------
# spot-estimate (default on Vercel, keyless international-spot estimate)
# | licensed (vendor API) | saved-html (default locally, personal only) | goodreturns (local only)
# saved-html/goodreturns are blocked on hosted deployments.
# RATE_PROVIDER=licensed
# Display copy. RATE_SOURCE_NAME is shown in the footer as "Rate data: <name>".
RATE_LOCATION=Bhubaneswar
RATE_SOURCE_NAME=

# ---- Licensed API (vendor-neutral mapping) -----------------------------------
# https only
LICENSED_API_URL=https://api.vendor.example/v1/gold
LICENSED_API_KEY=
# Send the key in a header ...
LICENSED_KEY_HEADER=x-api-key
# e.g. "Bearer " when using Authorization
LICENSED_KEY_PREFIX=
# ... or as a query parameter instead
LICENSED_KEY_PARAM=
# Weight the vendor quotes per: gram | 10gram | kg | troy_ounce
LICENSED_PRICE_UNIT=gram
# Dot paths into the JSON response (22K/18K optional)
LICENSED_PATH_24K=data.gold.k24
LICENSED_PATH_22K=data.gold.k22
LICENSED_PATH_18K=data.gold.k18
LICENSED_PATH_DATE=
# Derive a missing 22K/18K from 24K by purity (stored as source "licensed-derived")
LICENSED_DERIVE_MISSING=false

# ---- Storage (required on hosted deployments) --------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Scheduling / security ---------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Required when hosted (route fails closed).
CRON_SECRET=

# ---- Refresh on view (default on for spot-estimate) --------------------------
# RATE_REFRESH_ON_VIEW=true
# RATE_REFRESH_MINUTES=15

# ---- Local only --------------------------------------------------------------
# Keep different data series in different files (series are not comparable)
# GOLDPULSE_DATA_FILE=.data/spot.json
SAVED_HTML_PATH=.data/goodreturns-bhubaneswar.html
POLL_MINUTES=20
